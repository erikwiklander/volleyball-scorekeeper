{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "teams": {
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
          "$teamId": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && $teamId.matches(/^[a-f0-9-]{36}$/)",
            ".validate": "newData.hasChildren(['schemaVersion', 'revision', 'mutationId', 'deviceId', 'deleted', 'updatedAt']) && (newData.child('deleted').val() == !newData.child('team').exists()) && newData.child('revision').val() == (data.exists() ? data.child('revision').val() + 1 : 1) && newData.child('updatedAt').val() == now && (!data.exists() || newData.child('mutationId').val() != data.child('mutationId').val())",
            "schemaVersion": {
              ".validate": "newData.val() == 1"
            },
            "revision": {
              ".validate": "newData.isNumber() && newData.val() == (data.parent().exists() ? data.val() + 1 : 1)"
            },
            "mutationId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/) && (!data.exists() || newData.val() != data.val())"
            },
            "deviceId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            },
            "deleted": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "team": {
              ".validate": "newData.hasChildren(['id', 'sport', 'name', 'primaryColor', 'createdAt', 'updatedAt'])",
              "id": {
                ".validate": "newData.val() == $teamId"
              },
              "sport": {
                ".validate": "newData.val() == 'volleyball' || newData.val() == 'football'"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              },
              "shortName": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "primaryColor": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "secondaryColor": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "logo": {
                ".validate": "newData.isString() && newData.val().length <= 1500000 && newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+\\/=]+$/)"
              },
              "createdAt": {
                ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$/)"
              },
              "updatedAt": {
                ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$/)"
              },
              "$other": {
                ".validate": "false"
              }
            },
            "$other": {
              ".validate": "false"
            }
          }
        },
        "$other": {
          ".validate": "false"
        },
        "games": {
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
          "$recordId": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && $recordId.length > 0 && $recordId.length <= 128",
            ".validate": "newData.hasChildren(['schemaVersion','revision','mutationId','deviceId','deleted','updatedAt']) && newData.child('deleted').val() == !newData.child('payload').exists() && newData.child('revision').val() == (data.exists() ? data.child('revision').val()+1 : 1) && newData.child('updatedAt').val() == now && (!data.exists() || newData.child('mutationId').val() != data.child('mutationId').val()) && newData.hasChildren(['scorerDeviceId','scorerEpoch']) && newData.child('deviceId').val() == newData.child('scorerDeviceId').val() && (data.exists() ? ((newData.child('scorerEpoch').val() == data.child('scorerEpoch').val() && newData.child('scorerDeviceId').val() == data.child('scorerDeviceId').val() && newData.child('deviceId').val() == data.child('scorerDeviceId').val() && (data.child('deleted').val() == false || newData.child('deleted').val() == true)) || (newData.child('scorerEpoch').val() == data.child('scorerEpoch').val()+1 && data.child('deleted').val() == false && newData.child('deleted').val() == false && newData.child('payload').val() == data.child('payload').val())) : (newData.child('scorerEpoch').val() == 1))",
            "schemaVersion": {
              ".validate": "newData.val() == 1"
            },
            "revision": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 == 0"
            },
            "mutationId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            },
            "deviceId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            },
            "deleted": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "payload": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8000000"
            },
            "$other": {
              ".validate": "false"
            },
            "scorerEpoch": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 == 0"
            },
            "scorerDeviceId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            }
          }
        },
        "tournaments": {
          ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
          "$recordId": {
            ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && $recordId.length > 0 && $recordId.length <= 128",
            ".validate": "newData.hasChildren(['schemaVersion','revision','mutationId','deviceId','deleted','updatedAt']) && newData.child('deleted').val() == !newData.child('payload').exists() && newData.child('revision').val() == (data.exists() ? data.child('revision').val()+1 : 1) && newData.child('updatedAt').val() == now && (!data.exists() || newData.child('mutationId').val() != data.child('mutationId').val())",
            "schemaVersion": {
              ".validate": "newData.val() == 1"
            },
            "revision": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 == 0"
            },
            "mutationId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            },
            "deviceId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
            },
            "deleted": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() == now"
            },
            "payload": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8000000"
            },
            "$other": {
              ".validate": "false"
            }
          }
        }
      }
    },
    "analytics": {
      "site": {
        "summary": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com'"
        }
      },
      "games": {
        "$publicId": {
          "summary": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('matches').child($publicId).child('ownerUid').val() == auth.uid"
          }
        }
      }
    },
    "matches": {
      "$publicId": {
        ".validate": "newData.hasChildren([\"schemaVersion\", \"ownerUid\", \"revision\", \"published\", \"updatedAt\"]) && (newData.child('published').val() == newData.child('match').exists())",
        "schemaVersion": {
          ".validate": "newData.val() == 1"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 == 0"
        },
        "published": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "match": {
          ".validate": "newData.hasChildren([\"home\", \"away\", \"status\", \"tournament\", \"location\", \"currentSet\", \"result\"])",
          "home": {
            ".validate": "newData.hasChildren([\"name\", \"shortName\", \"color\", \"logo\"])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "shortName": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "logo": {
              ".validate": "newData.isString() && newData.val().length <= 1500000 && (newData.val() == '' || newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+\\/=]+$/))"
            },
            "$other": {
              ".validate": "false"
            }
          },
          "away": {
            ".validate": "newData.hasChildren([\"name\", \"shortName\", \"color\", \"logo\"])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "shortName": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "logo": {
              ".validate": "newData.isString() && newData.val().length <= 1500000 && (newData.val() == '' || newData.val().matches(/^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+\\/=]+$/))"
            },
            "$other": {
              ".validate": "false"
            }
          },
          "status": {
            ".validate": "newData.val() == 'not_started' || newData.val() == 'in_progress' || newData.val() == 'completed'"
          },
          "tournament": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "location": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "currentSet": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
          },
          "result": {
            ".validate": "newData.hasChildren([\"home\", \"away\", \"tied\"])",
            "home": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
            },
            "away": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
            },
            "tied": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
            },
            "$other": {
              ".validate": "false"
            }
          },
          "sets": {
            "$set": {
              ".validate": "newData.hasChildren([\"setNumber\", \"homeScore\", \"awayScore\", \"completed\"])",
              "setNumber": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
              },
              "homeScore": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
              },
              "awayScore": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
              },
              "completed": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": "false"
              }
            }
          },
          "$other": {
            ".validate": "false"
          },
          "sport": {
            ".validate": "newData.val() == 'volleyball' || newData.val() == 'football'"
          }
        },
        "$other": {
          ".validate": "false"
        },
        ".read": true,
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && newData.child('ownerUid').val() == auth.uid && (!data.exists() || (data.child('ownerUid').val() == auth.uid && newData.child('revision').val() > data.child('revision').val())) && (!data.child('gameId').exists() || newData.child('gameId').val() == data.child('gameId').val()) && (newData.child('gameId').exists() ? (newData.hasChildren(['gameId','scorerDeviceId','scorerEpoch']) && root.child('users').child(auth.uid).child('games').child(newData.child('gameId').val()).exists() && newData.child('scorerDeviceId').val() == root.child('users').child(auth.uid).child('games').child(newData.child('gameId').val()).child('scorerDeviceId').val() && newData.child('scorerEpoch').val() == root.child('users').child(auth.uid).child('games').child(newData.child('gameId').val()).child('scorerEpoch').val() && (newData.child('published').val() == false || root.child('users').child(auth.uid).child('games').child(newData.child('gameId').val()).child('deleted').val() == false)) : (!data.child('gameId').exists() && !newData.child('scorerDeviceId').exists() && !newData.child('scorerEpoch').exists()))",
        "gameId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "scorerDeviceId": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9-]{36}$/)"
        },
        "scorerEpoch": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 == 0"
        }
      }
    }
  }
}
